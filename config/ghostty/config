# テーマ
theme = TokyoNight Night

# 背景を透過
background-opacity = 0.9
# ブラー
background-blur-radius = 100

# フォント
font-family = CodeNewRoman Nerd Font Mono
font-size = 16

# 日本語フォント (Hiragino Sans)
font-codepoint-map = U+3040-U+309F=Hiragino Sans
font-codepoint-map = U+30A0-U+30FF=Hiragino Sans
font-codepoint-map = U+4E00-U+9FFF=Hiragino Sans
font-codepoint-map = U+3400-U+4DBF=Hiragino Sans
font-codepoint-map = U+F900-U+FAFF=Hiragino Sans
font-codepoint-map = U+3000-U+303F=Hiragino Sans
font-codepoint-map = U+FF00-U+FFEF=Hiragino Sans
font-codepoint-map = U+2E80-U+2EFF=Hiragino Sans
font-codepoint-map = U+3200-U+32FF=Hiragino Sans

# タイトルバーを透明にしてスッキリさせる
macos-titlebar-style = transparent
# フルスクリーン時にMac標準の挙動にする
macos-window-shadow = true
# 入力中はマウスカーソルを隠す
mouse-hide-while-typing = true
